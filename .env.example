# Copier ce fichier en .env (jamais commité)
DEBUG=True
SECRET_KEY=changez-moi
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://mon-domaine.tn

# Base de données (vide = SQLite locale)
# DATABASE_URL=postgres://user:pass@host:5432/db

# IA — clé Gemini : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT=20

# Asynchrone : True = Celery + Redis ; False = thread d'arrière-plan
USE_CELERY=False
REDIS_URL=redis://localhost:6379/0
