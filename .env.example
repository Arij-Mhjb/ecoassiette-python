# Copier ce fichier en .env (jamais commité)
DEBUG=True
SECRET_KEY=changez-moi
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://mon-domaine.tn

# Base de données (vide = SQLite locale)
# DATABASE_URL=postgres://user:pass@host:5432/db

# IA — clé Gemini : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT=60

# Génération d'illustrations communautaires via Pollinations
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=flux
POLLINATIONS_TIMEOUT=90

# Asynchrone : True = Celery + Redis ; False = thread d'arrière-plan
USE_CELERY=False
REDIS_URL=redis://localhost:6379/0

# Cloudflare R2 — stockage gratuit des avatars et photos Food Rescue
# Créer un bucket Standard, une clé API R2 et activer un domaine public/r2.dev.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=ecoassiette-media
CLOUDFLARE_R2_PUBLIC_URL=

# --- E-mails ---
# Option A (local) : Gmail. Activer la validation en 2 étapes puis créer un
# « mot de passe d'application » : https://myaccount.google.com/apppasswords
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=votre.adresse@gmail.com
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=votre.adresse@gmail.com
MAIL_FROM_NAME=EcoAssiette
CONFIRMATION_EMAIL=True
# Les variables Django EMAIL_HOST_USER, EMAIL_HOST_PASSWORD, etc. restent aussi acceptées.
# Option B (Render, qui bloque l'SMTP en gratuit) : Brevo, 300 e-mails/jour gratuits
# BREVO_API_KEY=xkeysib-...
# DEFAULT_FROM_EMAIL=EcoAssiette <adresse.verifiee.dans.brevo@gmail.com>
# Sans rien : les e-mails s'affichent dans le terminal (cmd).

# --- Médias persistants en production : Cloudflare R2 (bucket privé) ---
# CLOUDFLARE_R2_ACCOUNT_ID=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_R2_BUCKET=ecoassiette-media
